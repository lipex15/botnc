<Window x:Class="BotNC.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bot NC"
        Width="1240"
        Height="780"
        MinWidth="1040"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid Margin="22,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="36" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="BOT NC" FontSize="25" FontWeight="Bold" />
                    <TextBlock Text="{Binding VersionLabel}"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="12"
                               Margin="0,5,0,0" />
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <Button Content="Início" HorizontalContentAlignment="Left" Margin="0,0,0,8" />
                    <Button Content="Automações" HorizontalContentAlignment="Left" Margin="0,0,0,8" IsEnabled="False" />
                    <Button Content="Perfis" HorizontalContentAlignment="Left" Margin="0,0,0,8" IsEnabled="False" />
                    <Button Content="Diagnósticos" HorizontalContentAlignment="Left" Margin="0,0,0,8" IsEnabled="False" />
                    <Button Content="Configurações" HorizontalContentAlignment="Left" IsEnabled="False" />
                </StackPanel>

                <StackPanel Grid.Row="3">
                    <TextBlock Text="FUNDAÇÃO TÉCNICA"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="10"
                               FontWeight="SemiBold" />
                    <TextBlock Text="BitBlt + SendInput"
                               Margin="0,6,0,0"
                               FontSize="12" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="38,30,38,40">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Central de automação"
                                   FontSize="28"
                                   FontWeight="Bold" />
                        <TextBlock Text="Nova base isolada, modular e pronta para crescer."
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="14"
                                   Margin="0,7,0,0" />
                    </StackPanel>
                    <Border Grid.Column="1"
                            Background="#1D382F"
                            BorderBrush="#2C6C55"
                            BorderThickness="1"
                            CornerRadius="18"
                            Padding="15,8"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding SystemStatus}" Foreground="#8DE2BA" />
                    </Border>
                </Grid>

                <Border Style="{StaticResource DashboardCard}" Margin="0,30,0,0" Padding="24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="CLIENTE DO JOGO" Style="{StaticResource CardLabel}" />
                            <ComboBox ItemsSource="{Binding Clients}"
                                      SelectedItem="{Binding SelectedClient}"
                                      DisplayMemberPath="DisplayName"
                                      Height="40"
                                      Margin="0,10,0,0"
                                      Padding="10,5"
                                      Foreground="{StaticResource TextBrush}"
                                      Background="#101923"
                                      BorderBrush="{StaticResource BorderBrush}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="MODO DE ENVIO" Style="{StaticResource CardLabel}" />
                            <ComboBox ItemsSource="{Binding InputModes}"
                                      SelectedItem="{Binding SelectedInputMode}"
                                      DisplayMemberPath="DisplayName"
                                      Height="40"
                                      Margin="0,10,0,0"
                                      Padding="10,5"
                                      Foreground="{StaticResource TextBrush}"
                                      Background="#101923"
                                      BorderBrush="{StaticResource BorderBrush}" />
                        </StackPanel>

                        <StackPanel Grid.Column="4" VerticalAlignment="Bottom">
                            <Button Content="Atualizar clientes"
                                    Command="{Binding RefreshClientsCommand}"
                                    MinWidth="145"
                                    Margin="0,0,0,8" />
                            <Button Content="Testar tecla M"
                                    Command="{Binding SendMapKeyCommand}"
                                    MinWidth="145"
                                    Background="{StaticResource AccentBrush}"
                                    Foreground="#151109"
                                    BorderThickness="0" />
                        </StackPanel>

                        <TextBlock Grid.Column="0"
                                   Grid.ColumnSpan="3"
                                   Text="{Binding ClientStatus}"
                                   Style="{StaticResource CardDescription}"
                                   Margin="0,64,0,0" />
                    </Grid>
                </Border>

                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource DashboardCard}">
                        <StackPanel>
                            <TextBlock Text="CAPTURA" Style="{StaticResource CardLabel}" />
                            <TextBlock Text="{Binding CaptureEngine}" FontSize="17" FontWeight="SemiBold" Margin="0,12,0,0" />
                            <TextBlock Text="{Binding CaptureStatus}" Style="{StaticResource CardDescription}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource DashboardCard}">
                        <StackPanel>
                            <TextBlock Text="ENTRADA" Style="{StaticResource CardLabel}" />
                            <TextBlock Text="SendInput nativo" FontSize="17" FontWeight="SemiBold" Margin="0,12,0,0" />
                            <TextBlock Text="Mouse e teclado centralizados" Style="{StaticResource CardDescription}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="4" Style="{StaticResource DashboardCard}">
                        <StackPanel>
                            <TextBlock Text="ATUALIZAÇÕES" Style="{StaticResource CardLabel}" />
                            <TextBlock Text="GitHub Releases" FontSize="17" FontWeight="SemiBold" Margin="0,12,0,0" />
                            <TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource CardDescription}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Margin="0,26,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource DashboardCard}" Padding="24">
                        <StackPanel>
                            <TextBlock Text="Próxima etapa" FontSize="19" FontWeight="SemiBold" />
                            <TextBlock Text="A estrutura está pronta para receber o desenho definitivo da página inicial e os primeiros módulos da nova geração."
                                       Style="{StaticResource CardDescription}"
                                       TextWrapping="Wrap"
                                       Margin="0,12,0,0" />
                            <WrapPanel Margin="0,22,0,0">
                                <Button Content="Diagnosticar captura"
                                        Command="{Binding CheckEnvironmentCommand}"
                                        Background="{StaticResource AccentBrush}"
                                        Foreground="#151109"
                                        BorderThickness="0"
                                        Margin="0,0,10,0" />
                                <Button Content="Verificar atualização"
                                        Command="{Binding CheckUpdatesCommand}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource DashboardCard}" Padding="24">
                        <StackPanel>
                            <TextBlock Text="Módulos" FontSize="19" FontWeight="SemiBold" />
                            <TextBlock Text="Farm" Style="{StaticResource ModuleRow}" />
                            <TextBlock Text="Agenda" Style="{StaticResource ModuleRow}" />
                            <TextBlock Text="Masmorras" Style="{StaticResource ModuleRow}" />
                            <TextBlock Text="Monitoramento" Style="{StaticResource ModuleRow}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>

</Window>
